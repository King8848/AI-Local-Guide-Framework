# ====================================
# AI Travel Skill Core - Environment Variables
# ====================================
# Copy this file to .env and fill in your values.
# Do NOT commit .env to version control.
# ====================================

# ---- Map Services (Optional) ----
# OpenFreeMap tiles are free and don't require API key.
# If you want to use other tile providers, set their keys here.
# MAPTILER_API_KEY=
# MAPBOX_API_KEY=

# ---- Search Services (Optional) ----
# For real-time hotel/flight/attraction search.
# SERPER_API_KEY=

# ---- Weather (Optional) ----
# OPENWEATHER_API_KEY=

# ---- AI Agent Platform ----
# Your AI agent platform API key (e.g., Hermes, Claude, etc.)
# AGENT_API_KEY=
