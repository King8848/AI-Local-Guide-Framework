{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://ai-travel-skill-core/schema/trip-data.json",
  "title": "TripData",
  "description": "Standard travel plan data protocol — any frontend or agent can consume",
  "type": "object",
  "required": ["city", "days", "route"],
  "properties": {
    "city": {
      "type": "string",
      "description": "目的地城市名",
      "example": "杭州"
    },
    "days": {
      "type": "integer",
      "minimum": 1,
      "maximum": 30,
      "description": "旅行天数",
      "example": 3
    },
    "title": {
      "type": "string",
      "description": "方案标题",
      "example": "杭州3日深度游"
    },
    "style": {
      "type": "string",
      "enum": ["culture", "foodie", "nature", "photography", "family", "romantic", "budget", "luxury"],
      "description": "旅行风格标签"
    },
    "season": {
      "type": "string",
      "enum": ["spring", "summer", "autumn", "winter"],
      "description": "出行季节"
    },
    "route": {
      "type": "array",
      "description": "每日行程",
      "items": {
        "type": "object",
        "required": ["day", "theme", "items"],
        "properties": {
          "day": { "type": "integer", "minimum": 1 },
          "theme": { "type": "string", "description": "当天主题" },
          "area": { "type": "string", "description": "主区域" },
          "items": {
            "type": "array",
            "description": "当天活动列表",
            "items": {
              "type": "object",
              "required": ["name"],
              "properties": {
                "time": { "type": "string", "description": "时段", "example": "09:00-11:00" },
                "name": { "type": "string", "description": "活动/景点名" },
                "address": { "type": "string" },
                "type": { "type": "string", "enum": ["sightseeing", "food", "transport", "rest", "shopping"] },
                "duration": { "type": "string", "description": "建议停留时长" },
                "cost": { "type": "string", "description": "门票/费用" },
                "note": { "type": "string", "description": "补充说明" },
                "weather_sensitive": { "type": "boolean", "default": false },
                "indoor_backup": { "type": "string" }
              }
            }
          },
          "meals": {
            "type": "array",
            "description": "推荐用餐",
            "items": {
              "type": "object",
              "properties": {
                "type": { "type": "string", "enum": ["breakfast", "lunch", "dinner", "snack"] },
                "name": { "type": "string" },
                "cuisine": { "type": "string" },
                "budget": { "type": "string" },
                "recommendation": { "type": "string" }
              }
            }
          }
        }
      }
    },
    "food": {
      "type": "array",
      "description": "美食推荐汇总",
      "items": {
        "type": "object",
        "properties": {
          "category": { "type": "string", "description": "品类：早餐/面食/硬菜/夜市/酒水/糕点/伴手礼" },
          "name": { "type": "string" },
          "description": { "type": "string" },
          "where": { "type": "string" },
          "price": { "type": "string" }
        }
      }
    },
    "accommodation": {
      "type": "object",
      "description": "住宿建议",
      "properties": {
        "area": { "type": "string", "description": "推荐住宿区域" },
        "type": { "type": "string", "enum": ["hotel", "hostel", "bnb", "capsule"] },
        "budget_range": { "type": "string" },
        "suggestions": {
          "type": "array",
          "items": { "type": "string" }
        }
      }
    },
    "budget": {
      "type": "object",
      "description": "预算分析",
      "properties": {
        "total": { "type": "string" },
        "daily_average": { "type": "string" },
        "tier": { "type": "string", "enum": ["T1", "T2", "T3", "T4"] },
        "split": {
          "type": "object",
          "properties": {
            "accommodation": { "type": "string" },
            "food": { "type": "string" },
            "transport": { "type": "string" },
            "tickets": { "type": "string" },
            "reserve": { "type": "string" }
          }
        }
      }
    },
    "transport": {
      "type": "object",
      "description": "交通建议",
      "properties": {
        "arrival": { "type": "string", "description": "到达方式 + 机场/车站到市区" },
        "local": { "type": "string", "description": "市内交通建议" },
        "tips": { "type": "array", "items": { "type": "string" } }
      }
    },
    "packing": {
      "type": "array",
      "description": "行李清单",
      "items": { "type": "string" }
    },
    "tips": {
      "type": "array",
      "description": "避坑/注意事项",
      "items": { "type": "string" }
    },
    "warnings": {
      "type": "array",
      "description": "重要提醒（安全/天气/民俗）",
      "items": { "type": "string" }
    },
    "knowledge_source": {
      "type": "string",
      "description": "知识来源标注"
    },
    "generated_at": {
      "type": "string",
      "format": "date-time",
      "description": "生成时间"
    }
  }
}
